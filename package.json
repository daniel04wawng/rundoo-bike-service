{
  "name": "rundoo-bike-service",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype: bike-service research-to-work-order workflow as a proposed native Rundoo extension (mock adapters, synthetic data).",
  "type": "module",
  "engines": {
    "node": ">=20.11 <23"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "seed": "node scripts/seed.js",
    "reset": "node scripts/seed.js --reset",
    "fixture": "node --env-file-if-exists=.env scripts/run-fixture.js",
    "test": "node --test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "express": "4.21.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "vite": "5.4.11"
  }
}
