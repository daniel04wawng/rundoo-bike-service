# Copy to .env (or set in Railway). Never commit real values.
PORT=3000
# Separates state per run: data/runs/<EVAL_RUN_ID>/state.json
EVAL_RUN_ID=default
# Where run state lives (relative to repo root or absolute)
DATA_DIR=data/runs
# replay (default, deterministic rules parser) | live (Claude structured extraction, server-side only)
EXTRACTION_MODE=replay
# replay (default, recorded results in fixtures/ai_research) | live (Claude + web search on manufacturer domains)
RESEARCH_MODE=replay
# Only needed when EXTRACTION_MODE=live or RESEARCH_MODE=live. Server-side only; never exposed to the browser.
ANTHROPIC_API_KEY=
# Models: extraction (live), research (live, needs web search), intake (fast question step)
ANTHROPIC_MODEL=claude-opus-5-5
RESEARCH_MODEL=claude-sonnet-5-5
INTAKE_MODEL=claude-haiku-5-5
# Research reasoning effort (low keeps latency down)
RESEARCH_EFFORT=low
# Saved research answers (exact match on job type + confirmed parts)
RESEARCH_CACHE_DIR=data/cache/research
RESEARCH_CACHE_TTL_DAYS=30
# Set to false to disable POST /api/dev/reset in shared deployments
ALLOW_RESET=true
